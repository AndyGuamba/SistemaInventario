@model IEnumerable<Inventario.Modelos.Entidades.Marca>
<div class="container mt-4">
    <div class="d-flex justify-content-between">
        <h2>Gestión de Marcas</h2>
        <a asp-action="Crear" class="btn btn-primary">Nueva Marca</a>
    </div>
    <table class="table table-striped mt-3">
        <thead>
            <tr><th>ID</th><th>Nombre</th><th>Acciones</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.MarcaVehiculo</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('¿Borrar?')">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>