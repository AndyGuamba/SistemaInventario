@model Inventario.Modelos.Entidades.Marca
@{
    ViewData["Title"] = "Nueva Marca";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 card shadow p-4">
            <h2 class="text-primary mb-4">Registrar Nueva Marca</h2>
            <form asp-action="Crear" method="post">
                <div class="mb-3">
                    <label class="form-label">Nombre de la Marca</label>
                    <input asp-for="MarcaVehiculo" class="form-control" placeholder="Ej: Pilkington" required />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>