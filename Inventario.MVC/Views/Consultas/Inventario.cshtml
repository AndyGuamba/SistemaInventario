@model IEnumerable<Inventario.Modelos.Entidades.Parabrisa>

<div class="card shadow p-4 mb-4">
    <h4 class="text-primary"><i class="bi bi-search"></i> Buscador de Parabrisas</h4>
    <form asp-action="Inventario" method="get" class="row g-3">
        <div class="col-md-5">
            <input type="text" name="marca" value="@ViewBag.MarcaBusqueda" class="form-control" placeholder="Buscar por Marca..." />
        </div>
        <div class="col-md-5">
            <input type="text" name="modelo" value="@ViewBag.ModeloBusqueda" class="form-control" placeholder="Buscar por Modelo..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Buscar</button>
        </div>
    </form>
</div>

<div class="card shadow">
    <div class="card-header bg-dark text-white">
        <h5 class="mb-0">Inventario Disponible</h5>
    </div>
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Marca</th>
                        <th>Modelo</th>
                        <th>Año</th>
                        <th>Stock</th>
                        <th>Precio</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Marca?.MarcaVehiculo</td>
                            <td>@item.Modelo</td>
                            <td>@item.Anio</td>
                            <td><span class="badge bg-info text-dark">@item.Stock</span></td>
                            <td>$@item.Precio</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            @* Mensaje de Inexistente *@
            <div class="text-center py-5">
                <i class="bi bi-exclamation-octagon text-danger display-1"></i>
                <h3 class="mt-3 text-secondary">Producto Inexistente</h3>
                <p>No se encontraron parabrisas con esos criterios de búsqueda.</p>
                <a asp-action="Inventario" class="btn btn-outline-primary">Ver todo el inventario</a>
            </div>
        }
    </div>
</div>