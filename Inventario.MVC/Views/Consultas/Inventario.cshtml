@model IEnumerable<Inventario.Modelos.Entidades.Parabrisa>

@{
    ViewData["Title"] = "Consulta de Stock";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-search"></i> Inventario de Productos</h2>
        <span class="badge bg-info text-dark">Perfil: Empleado</span>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger shadow-sm">
            <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.Error
        </div>
    }

    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Listado de Parabrisas Disponibles</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>Año</th>
                            <th>Tipo</th>
                            <th>Ubicación</th>
                            <th class="text-center">Stock</th>
                            <th>Precio</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.Marca?.MarcaVehiculo</strong></td>
                                <td>@item.Modelo</td>
                                <td>@item.Anio</td>
                                <td>@item.Tipo</td>
                                <td><i class="bi bi-geo-alt"></i> @item.Ubicación</td>
                                <td class="text-center">
                                    @* Resaltamos el stock bajo en rojo *@
                                    @if (item.Stock <= 5)
                                    {
                                        <span class="badge bg-danger p-2" title="Stock Crítico">
                                            @item.Stock unidades
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success p-2">
                                            @item.Stock unidades
                                        </span>
                                    }
                                </td>
                                <td class="fw-bold text-primary">$@item.Precio</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                    <p class="mt-2 text-muted">No se encontraron productos en el inventario.</p>
                </div>
            }
        </div>
    </div>
</div>