@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Inventario</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Acceso" asp-action="Index">
                    <i class="bi bi-box-seam"></i> Inventario
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @* LÓGICA DE NAVEGACIÓN BASADA EN SESIÓN *@
                        @if (Context.Session.GetString("UsuarioCedula") != null)
                        {
                            var rol = Context.Session.GetInt32("UsuarioRol");

                            @if (rol == 1) // OPCIONES PARA ADMINISTRADOR
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Marcas" asp-action="Index">
                                        <i class="bi bi-tags"></i> Marcas
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="Parabrisas" asp-action="Index">
                                        <i class="bi bi-car-front"></i> Productos
                                    </a>
                                </li>
                            }

                            @* OPCIÓN COMÚN PARA ADMIN Y EMPLEADO *@
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Consultas" asp-action="Inventario">
                                    <i class="bi bi-search"></i> Consultar Stock
                                </a>
                            </li>

                            @* BOTÓN DE CIERRE DE SESIÓN AL FINAL *@
                            <li class="nav-item ms-auto">
                                <a class="nav-link text-danger fw-bold" asp-controller="Acceso" asp-action="Logout">
                                    <i class="bi bi-door-open"></i> Salir
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-light">
        <div class="container text-center">
            &copy; 2026 - Sistema de Inventario de Parabrisas
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>