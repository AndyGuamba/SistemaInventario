@{
    Layout = "_LayoutLogin";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-header bg-dark text-white text-center">
                <h4>Login - @ViewBag.RolNombre</h4>
            </div>
            <div class="card-body">
                <form asp-action="Validar" method="post">
                    <input type="hidden" name="rol" value="@ViewBag.RolValor" />

                    <div class="mb-3">
                        <label class="form-label">Número de Cédula</label>
                        <input type="text" name="cedula" class="form-control" required placeholder="Ej: 1752790475" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Contraseña</label>
                        <input type="password" name="password" class="form-control" required placeholder="********" />
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <button type="submit" class="btn btn-dark w-100">Entrar al Sistema</button>
                    <a asp-action="Index" class="btn btn-link w-100 mt-2">Volver atrás</a>
                </form>
            </div>
        </div>
    </div>
</div>