@{
    int rol = ViewBag.RolValor;
    ViewData["Title"] = "Login";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-4 card shadow p-4">
        <h2 class="text-center @(rol == 1 ? "text-primary" : "text-success")">Iniciar Sesión</h2>
        <form asp-action="Validar" method="post">
            <input type="hidden" name="rol" value="@rol" />
            <div class="mb-3">
                <label class="form-label">Usuario</label>
                <input type="text" name="usuario" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input type="password" name="password" class="form-control" required />
            </div>
            <button type="submit" class="btn @(rol == 1 ? "btn-primary" : "btn-success") w-100">Entrar</button>
        </form>
    </div>
</div>