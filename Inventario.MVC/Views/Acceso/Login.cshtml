@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Ingreso al Sistema";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-dark text-white text-center py-3">
                <h4 class="mb-0">
                    <i class="bi bi-person-badge"></i> Login - @ViewBag.RolNombre
                </h4>
            </div>
            <div class="card-body p-4">
                @* CORREGIDO: Ambos perfiles envían al método POST "Login" del AccesoController *@
                <form asp-controller="Acceso" asp-action="Login" method="post">

                    @* Campo oculto para pasar el rol al controlador *@
                    <input type="hidden" name="rol" value="@ViewBag.RolValor" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Número de Cédula</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                            <input type="text" name="cedula" class="form-control" required
                                   placeholder="Ej: 1752790475" maxlength="10" pattern="\d*" title="Ingrese solo números" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            @* Asegúrate que el controlador reciba el parámetro con este mismo nombre "contraseña" *@
                            <input type="password" name="contraseña" class="form-control" required placeholder="********" />
                        </div>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger shadow-sm py-2">
                            <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.Error
                        </div>
                    }

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn @(ViewBag.RolValor == 1 ? "btn-warning" : "btn-dark") w-100 fw-bold">
                            @if (ViewBag.RolValor == 1)
                            {
                                <span><i class="bi bi-envelope-at me-1"></i> Enviar Código al Correo</span>
                            }
                            else
                            {
                                <span><i class="bi bi-box-arrow-in-right me-1"></i> Entrar al Sistema</span>
                            }
                        </button>
                        <a asp-controller="Acceso" asp-action="Index" class="btn btn-link text-decoration-none">
                            <i class="bi bi-arrow-left"></i> Volver atrás
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelector('input[name="cedula"]').oninput = function () {
            this.value = this.value.replace(/[^0-9]/g, '');
        };
    </script>
}