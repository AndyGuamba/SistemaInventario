@{
    ViewData["Title"] = "Bienvenido";
}
<div class="text-center mt-5">
    <h1 class="display-4 fw-bold text-primary">Sistema de Inventario</h1>
    <p class="lead">Seleccione su perfil para ingresar</p>
    <div class="row justify-content-center mt-5">
        <div class="col-md-4">
            <div class="card shadow-sm border-primary p-4">
                <i class="bi bi-shield-lock-fill text-primary" style="font-size: 3rem;"></i>
                <h3 class="mt-3">Administrador</h3>
                <a asp-action="Login" asp-route-rol="1" class="btn btn-primary w-100 mt-3">Ingresar</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-success p-4">
                <i class="bi bi-person-badge text-success" style="font-size: 3rem;"></i>
                <h3 class="mt-3">Empleado</h3>
                <a asp-action="Login" asp-route-rol="0" class="btn btn-success w-100 mt-3">Ingresar</a>
            </div>
        </div>
    </div>
</div>