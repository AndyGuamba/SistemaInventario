@{
    Layout = "_LayoutLogin"; // Usaremos un layout sin barra de navegación para el inicio
}

<div class="container mt-5 text-center">
    <h2 class="mb-4">Bienvenido al Sistema de Inventario</h2>
    <p class="text-muted">Por favor, seleccione su perfil de ingreso:</p>

    <div class="row justify-content-center mt-5">
        <div class="col-md-4">
            <div class="card shadow-lg border-primary">
                <div class="card-body">
                    <i class="bi bi-person-badge-fill" style="font-size: 3rem; color: #0d6efd;"></i>
                    <h4 class="mt-3">Administrador</h4>
                    <a asp-action="Login" asp-route-rol="1" class="btn btn-primary w-100 mt-3">Ingresar</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-lg border-success">
                <div class="card-body">
                    <i class="bi bi-person-fill" style="font-size: 3rem; color: #198754;"></i>
                    <h4 class="mt-3">Empleado</h4>
                    <a asp-action="Login" asp-route-rol="0" class="btn btn-success w-100 mt-3">Ingresar</a>
                </div>
            </div>
        </div>
    </div>
</div>