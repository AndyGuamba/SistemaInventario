@model Inventario.Modelos.Entidades.Parabrisa
@{
    ViewData["Title"] = "Nuevo Parabrisa";
}

<div class="container mt-4">
    <div class="card shadow p-4">
        <h2 class="text-primary mb-4">
            <i class="bi bi-box-seam"></i> Agregar Producto al Inventario
        </h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger shadow-sm alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.Error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="Crear" method="post">
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Tipo de Vidrio</label>
                    <select asp-for="Tipo" class="form-select" required>
                        <option value="">-- Seleccione Código --</option>
                        <option value="PD">PD - Parabrisas Delantero</option>
                        <option value="PP">PP - Parabrisas Posterior</option>
                        <option value="VDI">VDI - Ventana Delantera Izquierda</option>
                        <option value="VDD">VDD - Ventana Delantera Derecha</option>
                        <option value="VPI">VPI - Ventana Posterior Izquierda</option>
                        <option value="VPD">VPD - Ventana Posterior Derecha</option>
                        <option value="LPI">LPI - Lateral Posterior Izquierdo</option>
                        <option value="LPD">LPD - Lateral Posterior Derecho</option>
                        <option value="VRD">VRD - Ventolera Derecha</option>
                        <option value="VRI">VRI - Ventolera Izquierda</option>
                        <option value="CauchoD">CauchoD- Caucho Delantero </option>
                        <option value="CauchoP">CauchoP- Caucho Posterior </option>
                        <option value="CauchoVR">CauchoVR- Caucho Ventolera </option>
                    </select>
                    <span asp-validation-for="Tipo" class="text-danger small"></span>
                </div>

                @* CORRECCIÓN: Ahora es un input de texto normal *@
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Marca de Vehículo</label>
                    <input asp-for="Marca" class="form-control" placeholder="Ej: Toyota, Chevrolet" required />
                    <span asp-validation-for="Marca" class="text-danger small"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Modelo</label>
                    <input asp-for="Modelo" class="form-control" placeholder="Ej: Sail, Hilux" required />
                    <span asp-validation-for="Modelo" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="form-label fw-bold">Año</label>
                    <input asp-for="Anio" type="number" class="form-control" placeholder="Ej: 2024" />
                    <span asp-validation-for="Anio" class="text-danger small"></span>
                </div>

                <div class="col-md-9 mb-3">
                    <label class="form-label fw-bold">Ubicación en Bodega</label>
                    <input asp-for="Ubicación" class="form-control" placeholder="Ej: Estante A-12 / Fila 3" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Precio Unitario</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Precio" type="number" step="0.01" class="form-control" required />
                    </div>
                    <span asp-validation-for="Precio" class="text-danger small"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Stock Inicial</label>
                    <input asp-for="Stock" type="number" class="form-control" required />
                    <span asp-validation-for="Stock" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                <a asp-action="Index" class="btn btn-secondary me-md-2">
                    <i class="bi bi-x-circle"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Guardar Producto
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}