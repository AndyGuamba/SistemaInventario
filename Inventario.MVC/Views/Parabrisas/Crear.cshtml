@model Inventario.Modelos.Entidades.Parabrisa
@{
    ViewData["Title"] = "Nuevo Parabrisa";
}

<div class="container mt-4">
    <div class="card shadow p-4">
        <h2 class="text-primary mb-4">
            <i class="bi bi-box-seam"></i> Agregar Producto al Inventario
        </h2>

        @* Bocina de errores para detectar fallos de la API *@
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger shadow-sm alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.Error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form asp-action="Crear" method="post">
            @Html.AntiForgeryToken()

            <div class="row">
                @* Campo: Modelo / Descripción *@
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Modelo / Descripción</label>
                    <input asp-for="Modelo" class="form-control" placeholder="Ej: Chevrolet Sail" required />
                    <span asp-validation-for="Modelo" class="text-danger small"></span>
                </div>

                @* Campo: Marca (CORREGIDO) *@
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Marca de Vehículo</label>
                    <select asp-for="MarcaId" class="form-select"
                            asp-items="@(new SelectList(ViewBag.Marcas ?? new List<Inventario.Modelos.Entidades.Marca>(), "Id", "MarcaVehiculo"))" required>
                        <option value="">-- Seleccione Marca --</option>
                    </select>
                    <span asp-validation-for="MarcaId" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                @* Campo: Tipo (NUEVO) *@
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Tipo de Vidrio</label>
                    <select asp-for="Tipo" class="form-select" required>
                        <option value="">-- Seleccione Tipo --</option>
                        <option value="Delantero">Delantero (Parabrisa)</option>
                        <option value="Posterior">Posterior (Luneta)</option>
                        <option value="Ventana">Ventana (Lateral)</option>
                        <option value="Aleta">Aleta / Custodio</option>
                    </select>
                </div>

                @* Campo: Año (NUEVO) *@
                <div class="col-md-2 mb-3">
                    <label class="form-label fw-bold">Año</label>
                    <input asp-for="Anio" class="form-control" placeholder="2023" />
                </div>

                @* Campo: Ubicación (NUEVO) *@
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Ubicación en Bodega</label>
                    <input asp-for="Ubicación" class="form-control" placeholder="Ej: Estante A-12" />
                </div>
            </div>

            <div class="row">
                @* Campo: Precio *@
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Precio Unitario</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Precio" type="number" step="0.01" class="form-control" required />
                    </div>
                </div>

                @* Campo: Stock *@
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Stock Inicial</label>
                    <input asp-for="Stock" type="number" class="form-control" required />
                </div>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                <a asp-action="Index" class="btn btn-secondary me-md-2">
                    <i class="bi bi-x-circle"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Guardar Producto
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}