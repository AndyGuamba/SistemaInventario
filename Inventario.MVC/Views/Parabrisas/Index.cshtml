<table class="table">
    <thead>
        <tr>
            <th>Marca</th>
            <th>Modelo</th>
            <th>Stock</th>
            @if (Context.Session.GetInt32("UsuarioRol") == 1)
            {
                <th>Acciones</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Marca?.MarcaVehiculo</td>
                <td>@item.Modelo</td>
                <td>
                    @* Resaltado de stock bajo *@
                    <span class="@(item.Stock < 5 ? "text-danger fw-bold" : "")">
                        @item.Stock unidades
                    </span>
                </td>
                @if (Context.Session.GetInt32("UsuarioRol") == 1)
                {
                    <td>
                        @* Botón para editar/rebajar stock *@
                        <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                        @* Botón para eliminar *@
                        <a asp-action="Eliminar" asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('¿Seguro que desea eliminar este parabrisas?');">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>