@model IEnumerable<Inventario.Modelos.Entidades.Parabrisa>
<div class="container mt-4">
    <h2>Catálogo de Parabrisas</h2>
    <div class="row mt-3">
        @foreach (var p in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@p.Modelo</h5>
                        <p class="card-text text-muted">Stock: @p.Stock</p>
                        <a asp-action="Detalles" asp-route-id="@p.Id" class="btn btn-outline-info btn-sm">Ver más</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>