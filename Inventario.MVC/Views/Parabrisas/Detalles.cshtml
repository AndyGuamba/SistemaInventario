@model Inventario.Modelos.Entidades.Parabrisa
@{
    ViewData["Title"] = "Ficha Técnica";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-info text-white">
            <h3>Detalles del Parabrisa: @Model.Modelo</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID Producto:</dt>
                <dd class="col-sm-9">@Model.Id</dd>
                <dt class="col-sm-3">Precio:</dt>
                <dd class="col-sm-9 text-success fw-bold">$@Model.Precio</dd>
                <dt class="col-sm-3">Existencias:</dt>
                <dd class="col-sm-9">@Model.Stock unidades</dd>
            </dl>
            <div class="mt-4">
                <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-warning">Editar Información</a>
                <a asp-action="Index" class="btn btn-secondary">Volver al Catálogo</a>
            </div>
        </div>
    </div>
</div>